<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot parent -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <!-- Project coordinates -->
    <groupId>com.achhecode</groupId>
    <artifactId>browser-pilot</artifactId>
    <version>2.0.0</version>
    <packaging>pom</packaging>

    <name>browser-pilot</name>
    <description>Browser automation services</description>

    <!-- Shared properties -->
    <properties>
        <java.version>25</java.version>

        <lombok.version>1.18.42</lombok.version>
        <playwright.version>1.63.0</playwright.version>
        <jna.version>5.19.1</jna.version>
        <jnativehook.version>2.2.2</jnativehook.version>
        <springdoc.version>3.1.1</springdoc.version>
    </properties>

    <!-- Centralized dependency version management -->
    <dependencyManagement>
        <dependencies>

            <!-- Browser automation -->
            <dependency>
                <groupId>com.microsoft.playwright</groupId>
                <artifactId>playwright</artifactId>
                <version>${playwright.version}</version>
            </dependency>

            <!-- Springdoc OpenAPI UI -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- Lombok -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>

            <dependency>
                <groupId>com.achhecode</groupId>
                <artifactId>browser-pilot-dto</artifactId>
                <version>${project.version}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <!-- Child services -->
    <modules>
        <module>browser-pilot-dto</module>
        <module>instahyre-service</module>
        <!-- <module>keyboard-service</module> -->
        <module>linkedin-service</module>
        <module>pinpoint-service</module>
    </modules>

    <!-- Shared build configuration -->
    <build>
        <plugins>

            <!-- Lombok annotation processing for child modules -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>