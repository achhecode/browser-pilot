{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build All Three",
      "type": "shell",
      "command": "./mvnw -pl linkedin-service,pinpoint-service,game-orchestrator -am clean package",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Clean All Three",
      "type": "shell",
      "command": "./mvnw -pl linkedin-service,pinpoint-service,game-orchestrator -am clean",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Run All Three",
      "type": "shell",
      "command": "./mvnw -pl linkedin-service,pinpoint-service,game-orchestrator -am install -DskipTests && ./mvnw -pl linkedin-service,pinpoint-service,game-orchestrator -DskipTests spring-boot:run",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": [],
      "isBackground": true
    }
  ]
}